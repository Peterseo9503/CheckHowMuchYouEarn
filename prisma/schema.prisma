generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 바이낸스 income 기록을 (symbol, tradeId) 단위로 묶은 개별 거래/체결 단위
model Trade {
  id          String   @id @default(cuid())
  uid         String   @unique // 중복 방지 키: "SYMBOL-tradeId" 또는 "FUNDING-tranId"
  symbol      String
  kind        String   // TRADE | FUNDING
  time        DateTime // 체결 시각 (UTC)
  date        String   // KST 기준 YYYY-MM-DD (집계용)

  side         String  @default("") // BUY | SELL
  positionSide String  @default("") // LONG | SHORT | BOTH
  method       String  @default("") // MANUAL | STOP | TAKE_PROFIT | TRAILING | LIQUIDATION | ADL | UNKNOWN
  qty          Float   @default(0)  // 합산 체결 수량
  avgPrice     Float   @default(0)  // 가중평균 체결가

  pnlUsdt     Float    @default(0) // Realized PnL
  feeUsdt     Float    @default(0) // 수수료 (음수 = 지출)
  fundingUsdt Float    @default(0)
  rate        Float    // 적용 USD/KRW
  pnlKrw      Float    @default(0)
  feeKrw      Float    @default(0)
  fundingKrw  Float    @default(0)
  netKrw      Float    @default(0) // pnl + fee + funding

  // 매매 일지 (마크다운)
  tradeReason String   @default("")
  tags        String   @default("") // 콤마 구분. SQLite는 배열 미지원

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([time])
}

model ExchangeRate {
  date String @id // YYYY-MM-DD
  rate Float
}

/// 입금 / 출금 / 선물 지갑 이체 기록
model Transfer {
  id        String   @id @default(cuid())
  uid       String   @unique // "DEPOSIT-id" | "WITHDRAW-id" | "TRANSFER-tranId"
  type      String   // DEPOSIT | WITHDRAW | FUTURES_IN | FUTURES_OUT
  coin      String
  amount    Float    // 항상 양수
  fee       Float    @default(0)
  network   String   @default("")
  status    String   @default("")
  txId      String   @default("")
  time      DateTime
  date      String   // KST YYYY-MM-DD
  priceUsdt Float?   // 거래 시각의 코인 가격 (USDT). 스테이블코인은 1
  rate      Float?   // USD/KRW
  amountKrw Float?
  createdAt DateTime @default(now())

  @@index([time])
}

/// 95점+ 자동매매 봇 설정 (단일 설정 행 id="default")
model AutoBotConfig {
  id               String   @id @default("default")
  enabled          Boolean  @default(false) // 자동매매 활성화 여부
  paperMode        Boolean  @default(true)  // true: 모의투자(가상 체결), false: 바이낸스 실주문
  minConfidence    Int      @default(95)    // 최소 타점 신뢰도 점수 (기본 95점)
  timeframe        String   @default("15m") // 스캔 기준 분봉 (15m | 1h | 4h)
  marginUsdt       Float    @default(30)    // 1회 진입 증거금 (USDT)
  leverage         Int      @default(5)     // 진입 레버리지 배율
  marginType       String   @default("ISOLATED") // ISOLATED | CROSSED
  maxOpenPositions Int      @default(2)     // 동시 보유 가능한 최대 포지션 수
  cooldownMin      Int      @default(240)   // 동일 코인 재진입 금지 쿨타임 (분, 기본 4시간)
  allowLong        Boolean  @default(true)
  allowShort       Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

/// AI 타점 추천(95점+)으로 실행된 자동매매 전용 기록
model AutoTrade {
  id              String    @id @default(cuid())
  symbol          String
  side            String    // LONG | SHORT
  isPaper         Boolean   @default(true)  // 모의투자 여부
  timeframe       String    // 15m | 1h | 4h
  strategyName    String    // 전략명
  confidence      Int       // 진입 당시 신뢰도 점수 (예: 96)
  reasons         String    // 진입 근거 목록 (JSON 문자열)
  rsiAtEntry      Float     @default(0)
  volSpikeAtEntry Float     @default(1)

  marginUsdt      Float     // 투입 증거금 (USDT)
  leverage        Int       // 레버리지
  quantity        Float     // 주문 수량
  entryPrice      Float     // 진입가
  stopLoss        Float     // 손절가 (SL)
  tp1             Float     // 1차 익절가 (TP1)
  tp2             Float     // 2차 익절가 (TP2)
  rrRatio         Float     @default(2.0)

  status          String    @default("OPEN") // OPEN | TP1_HIT | TP2_HIT | SL_HIT | CLOSED | ERROR
  exitPrice       Float?    // 종료(익절/손절/청산) 가격
  pnlUsdt         Float     @default(0)      // 확정 또는 평가 손익 (USDT)
  pnlRoiPct       Float     @default(0)      // 증거금 대비 수익률 (%)
  orderId         String    @default("")     // 바이낸스 주문번호
  logs            String    @default("")     // 실행/체결 로그
  note            String    @default("")     // 사용자 메모

  createdAt       DateTime  @default(now())
  closedAt        DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
  @@index([symbol])
  @@index([status])
}

/// 단일 사용자 마스터 비밀번호 / PIN 인증 및 5회 오류 잠금 상태
model AuthConfig {
  id             String    @id @default("master")
  passwordHash   String    @default("") // "salt:hash" (scrypt). 비어 있으면 .env의 MASTER_PASSWORD 사용
  failedAttempts Int       @default(0)  // 연속 실패 횟수 (5회 이상 시 잠금)
  lockedUntil    DateTime?              // 잠금 해제 시각
  updatedAt      DateTime  @updatedAt
}
